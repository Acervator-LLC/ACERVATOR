        STATE_COLORS = {
            "running":   QColor("#00ff88"),
            "idle":      QColor("#888888"),
            "paused":    QColor("#ffaa00"),
            "error":     QColor("#ff3366"),
            "cooldown":  QColor("#ff6600"),
            "stopped":   QColor("#666666"),
