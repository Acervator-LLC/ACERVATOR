            "type": "command",
            "command": "python -X utf8 __HOOK_DIR__/block_banned_words.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 __HOOK_DIR__/block_screen_point_input.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Workflow|Write|Edit|NotebookEdit|Bash|PowerShell|Monitor|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 __HOOK_DIR__/block_unloaded_skills.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 __HOOK_DIR__/archetype_gate.py",
            "timeout": 240
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 __HOOK_DIR__/block_unloaded_skills.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 __HOOK_DIR__/prompt_router.py",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 __HOOK_DIR__/session_stop_backstop.py",
