      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 __HOOK_DIR__/block_deflection.py",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 __HOOK_DIR__/block_banned_words.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 __HOOK_DIR__/block_unloaded_skills.py",
            "timeout": 15
          }
        ]
      }
    ]
